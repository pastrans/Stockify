datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  CASHIER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CASHIER)
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DisplayType {
  select
  pills
  radio
  color
}

enum VariantCreation {
  instantly
  dynamically
  never
}

model Attribute {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  sequence        Int             @default(0)
  displayType     DisplayType     @default(radio)
  variantCreation VariantCreation @default(instantly)
  available       Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  values          AttributeValue[]

  @@index([sequence])
}

model AttributeValue {
  id          Int       @id @default(autoincrement())
  valueName   String
  shortName   String    // Código compacto para ensamble de SKU (ej. "AZM", "XL")
  colorHex    String?   // Código HEX (ej. "#000080") si displayType == color
  sequence    Int       @default(0)
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, valueName])
  @@unique([attributeId, shortName])
  @@index([attributeId, sequence])
}